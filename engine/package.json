{
  "name": "kb-engine",
  "version": "1.0.0-rc.4",
  "private": true,
  "description": "The Engine service: a private knowledge index served to Claude over MCP, filtered by who is asking.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "gen:schema": "tsx scripts/gen-config-schema.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.12.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.45.0",
    "hono": "^4.5.0",
    "jose": "^6.2.3",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.5.0",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.5.0",
    "prettier": "^3.3.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0",
    "zod-to-json-schema": "^3.25.2"
  }
}
