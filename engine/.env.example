# The service's settings, for a local run. Copy to `.env` and fill in.
# Every name the service reads (engine/src/env.ts) is listed here; the full
# meaning of each is in docs/configuration.md.
#
# NEVER put a real value in this file, and never commit `.env`.
# A value written <like-this> is a placeholder: replace it, or delete the line.
# A line that starts with `#` is off. Leave optional lines off unless you
# need them.

# ---- Required ---------------------------------------------------------------

# The Supabase project.
SUPABASE_URL=https://<your-project-ref>.supabase.co
# The publishable anon key (not a secret).
SUPABASE_ANON_KEY=<your-supabase-anon-key>
# SECRET. The project's JWT secret, at least 32 characters.
SUPABASE_JWT_SECRET=<your-supabase-jwt-secret>
# SECRET. Token of the service's own principal, which may embed and nothing
# else. Minted after the first `kbe config apply`.
# Optional when the app's Database screen set up the project (the token is then in Supabase Vault).
EMBED_TOKEN=<your-embed-token>

# ---- Optional: process --------------------------------------------------------

# PORT=8080
# NODE_ENV=development
# LOG_LEVEL=info
# The deployed commit, shown by /health. Set by the hosting platform.
# SOURCE_COMMIT=

# The database schema that holds the knowledge index. Leave off for the
# default (`workspace`). Use the same value everywhere (docs/configuration.md).
# KB_SCHEMA=

# ---- Optional: updates ----------------------------------------------------------

# The public repository (owner/name) whose `stable` branch the Updates screen
# compares this Engine with. Leave off for the default.
# QB_RELEASE_REPO=
# DigitalOcean's id for this app, for a direct link from the Updates screen.
# Set by the hosting platform (the app spec binds ${APP_ID}).
# APP_ID=

# ---- Optional: setup page -------------------------------------------------------

# SECRET. The one-time code that opens /setup. Shown once by
# `python -m kbe access init`. Remove it again when setup is complete.
# SETUP_CODE=

# ---- Optional: sign-in settings -------------------------------------------------
# Leave all of these off on a new Engine: setup stores them in the database.
# The first four are set together or not at all.

# CF_ACCESS_TEAM_DOMAIN=https://<your-team>.cloudflareaccess.com
# CF_ACCESS_AUD=<aud-tag-of-the-connector-application>
# OAUTH_RESOURCE_URL=https://<engine.example.com>/mcp
# EXPECTED_HOST=<engine.example.com>

# AUD tag of the separate sign-in application that guards /status.
# CF_ACCESS_STATUS_AUD=<aud-tag-of-the-status-application>

# Comma-separated email domains allowed to sign in. A second check only.
# ALLOWED_EMAIL_DOMAINS=example.com,example.org
