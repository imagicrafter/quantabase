# Local settings for the `kbe` command line, the scheduled jobs and the scripts.
#
# Copy this file to `.env` in the same folder and fill it in. `.env` is
# git-ignored. Never commit a real value and never paste one into a chat.
#
# A line still holding its `<...>` placeholder, and a line with nothing after
# the `=`, both count as NOT SET. Fill in what you have; the command that
# needs a missing value names it.
#
# Replace the whole `<...>`, brackets included. A real value left inside the
# brackets counts as NOT SET. To check the file without showing a value:
#   python -m kbe env check
#
# Lines that start with `#` are off. Remove the `#` to use them.
# The full reference is docs/configuration.md (Part 2).

# --- The Supabase project ----------------------------------------------------
# Supabase dashboard -> Project Settings -> API.
SUPABASE_URL=<https://your-project-ref.supabase.co>
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_JWT_SECRET=<your-jwt-secret>

# Direct Postgres connection string, for `kbe db migrate`, `kbe verify`,
# `kbe people`, `kbe issues`, `kbe tokens` and `kbe support`.
# Supabase dashboard -> Project Settings -> Database -> Connection string.
KBE_DATABASE_URL=<postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres>

# Only for scripts the owner runs by hand that need it (the full access
# suite, the older mint_token script). Never put it on a deployed job.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Optional. The project ref is taken from SUPABASE_URL when this is not set.
# SUPABASE_PROJECT_REF=<your-project-ref>
# Optional. A Supabase personal access token, for `kbe db deploy-functions`
# and `kbe db expose-schema`. Without it, run `supabase login` first.
SUPABASE_ACCESS_TOKEN=<your-supabase-access-token>

# --- The schema ---------------------------------------------------------------
# Which Postgres schema holds the knowledge index. Leave it off to use
# `workspace`. Use the same value on the service, every job and here.
# KB_SCHEMA=workspace

# --- Embedding ----------------------------------------------------------------
# `remote` calls the embed function (what deployed jobs use). `local` needs
# sentence-transformers on this machine.
KNOWLEDGE_EMBED_BACKEND=remote
KNOWLEDGE_EMBED_URL=<https://your-project-ref.supabase.co/functions/v1/embed>
# Written here by: python -m kbe tokens mint --embed --write-env
KNOWLEDGE_EMBED_TOKEN=

# --- The model that writes the summaries --------------------------------------
# Set by `kbe deploy render` on a deployed job from models.distill in the
# Engine config. For local runs:
KNOWLEDGE_MODEL_BACKEND=do
KNOWLEDGE_MODEL_ID=openai-gpt-oss-120b
# The key of the backend you chose (one of the two).
DO_INFERENCE_KEY=<your-inference-key>
ANTHROPIC_API_KEY=<your-anthropic-key>

# --- The wiki (knowledge repo) --------------------------------------------------
# Where the knowledge repo is checked out on this machine. When the path does
# not exist the jobs clone the repo named in the config into their own cache.
# KNOWLEDGE_WIKI_ROOT=<path-to-your-knowledge-repo-clone>
# A fine-grained GitHub token for that one repo (contents: read and write).
GITHUB_TOKEN=<your-github-token>
# Used when GITHUB_TOKEN is not set.
# GH_TOKEN=<your-github-token>

# --- Meetings (Fireflies) -------------------------------------------------------
FIREFLIES_API_KEY=<your-fireflies-api-key>
# Removing old transcripts from Fireflies once they are safely stored. Off by
# default; with DRY_RUN on it only reports what it would remove.
# FIREFLIES_RETENTION_ENABLED=false
FIREFLIES_RETENTION_DRY_RUN=true
# FIREFLIES_RETENTION_DAYS=90
# Read only by the separate upstream-delete sweep; no scheduled job uses it.
# FIREFLIES_UPSTREAM_DELETE_EXECUTE=false

# --- Google Drive ---------------------------------------------------------------
# Both come from: python -m kbe sources drive auth --client-secret FILE --out FILE
DRIVE_TOKEN_JSON_B64=
DRIVE_TOKEN_CLIENT_JSON_B64=

# --- Gmail (optional; only when the config turns the mail source on) ----------
# From: python -m kbe sources gmail auth --client-secret FILE --out FILE
GMAIL_TOKEN_JSON_B64=

# --- Sign-in settings on a job (rare) -------------------------------------------
# A job indexes nothing until sign-in is set up. Setup stores these in the
# database, which is the normal case: leave both off. They are for a
# deployment that keeps its sign-in settings in the environment instead
# (`kbe deploy render --cf-team-domain ... --cf-aud ...`). Neither is a secret.
# CF_ACCESS_TEAM_DOMAIN=<https://your-team.cloudflareaccess.com>
# CF_ACCESS_AUD=<the-application-aud-tag>

# --- Per-person tokens ------------------------------------------------------------
# A person's own token for local search (`python -m knowledge.search`), one
# line per person, named KNOWLEDGE_TOKEN_<HANDLE>. Written here by:
#   python -m kbe tokens mint --handle <handle> --write-env
# Whose token local search uses is KNOWLEDGE_HANDLE in your shell (default:
# the owner).

# --- Run records ------------------------------------------------------------------
# The commit to stamp on run events when git is not available.
# OBS_COMMIT=<commit-sha>

# --- Read from your shell, not from this file -------------------------------------
# These change where the command line looks. Set them in the shell (or in
# front of the command) when you need them; a line here has no effect.
# KBE_ENV_FILE=<path-to-another-settings-file>
# KBE_STATE_FILE=<path-to-another-state-file>
# KBE_PSQL=<path-to-psql>
# KB_ENGINE_CONFIG=<path-to-an-engine.yaml-for-development>
# KNOWLEDGE_HANDLE=<a-principal-handle>
